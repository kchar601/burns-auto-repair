{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "burnsautorepair.com"
        }
      ],
      "status": 308,
      "dest": "https://www.burnsautorepair.com/$1"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "query",
          "key": "et_core_page_resource"
        }
      ],
      "status": 410,
      "dest": "/404.html"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "query",
          "key": "option",
          "value": "com_content"
        }
      ],
      "status": 410,
      "dest": "/404.html"
    },
    {
      "src": "^/(services|about|contact|testimonials)/$",
      "status": 308,
      "dest": "/$1"
    },
    {
      "src": "^/contact-us(?:/.*)?$",
      "status": 301,
      "dest": "/contact"
    },
    {
      "src": "^/index\\.php$",
      "status": 410,
      "dest": "/404.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/(services|about|contact|testimonials)$",
      "dest": "/index.html"
    },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
