{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "^/(services|about|contact|testimonials)/$",
      "status": 308,
      "dest": "/$1"
    },
    {
      "src": "^/contact-us/?$",
      "status": 308,
      "dest": "/contact"
    },
    {
      "src": "^/index\\.php$",
      "status": 410,
      "dest": "/404.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/(services|about|contact|testimonials)$",
      "dest": "/index.html"
    },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
