{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "burnsautorepair.com" }],
      "destination": "https://www.burnsautorepair.com/:path",
      "permanent": true
    },
    { "source": "/services-2", "destination": "/services", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/index.php", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(services|about|contact|testimonials)", "destination": "/index.html" }
  ]
}